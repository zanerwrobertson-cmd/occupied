# Copy to .env.local (git-ignored) and fill in. See TESTING.md.

# Shared secret between the simulator (or ITS) and the server. Make up a long random string.
INGEST_KEY=

# Where the simulator posts readings.
API_URL=http://localhost:4000

# Where the app reads /occupancy. Leave empty to use mock data.
# On a phone this must be your computer's LAN IP (e.g. http://192.168.1.23:4000), not localhost.
EXPO_PUBLIC_API_URL=
